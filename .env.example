# Copy to .env (or set in your host's dashboard). Everything is optional.
SECRET_KEY=change-me
PORT=5000

# --- Advertising (leave empty until your AdSense account/site is approved) ---
ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX
ADSENSE_SLOT_PREGAME=0000000000     # ad unit shown on the "match starting" screen
ADSENSE_SLOT_POSTGAME=0000000000    # ad unit shown on the results screen
ADSENSE_SLOT_BANNER=0000000000      # ad unit beside the board / in the lobby
LUDO_AD_PLACEHOLDERS=1              # 0 = hide the empty "Ad space" boxes in production

# --- Gameplay timing (seconds) ---
LUDO_PREGAME_SECONDS=6
LUDO_TURN_SECONDS=40
LUDO_BOT_DELAY=0.9
# LUDO_ALLOWED_ORIGINS=https://yourdomain.com
